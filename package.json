{
  "name": "monaco-json-studio-double",
  "version": "1.1.1",
  "description": "Two-pane Monaco JSON Studio built on monaco-json-studio-base.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavsoft/monaco-json-studio-double.git"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "monaco-json-studio-double": "./bin/index.js"
  },
  "files": [
    "src",
    "bin",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --check src/index.js && node --check src/v1/index.js && node --check src/v2/index.js && node --check src/v3/index.js && node --check bin/index.js"
  },
  "dependencies": {
    "handlebars": "^4.7.10",
    "monaco-json-studio-base-body": "^1.3.1",
    "monaco-json-studio-base-footer": "^1.1.1",
    "monaco-json-studio-base-header": "^1.2.1"
  },
  "keywords": [
    "monaco",
    "monaco-editor",
    "json-studio",
    "double-pane",
    "keshavsoft"
  ],
  "author": "KeshavSoft",
  "license": "MIT"
}